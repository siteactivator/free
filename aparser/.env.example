# Скопируйте этот файл в .env (в той же папке) и поправьте значения под себя.
# Файл .env остаётся только у вас: .gitignore не пускает его в git.

# Адрес API A-Parser. Если A-Parser стоит на этом же компьютере — не меняйте.
# Порт — из строки bind в config\config.txt A-Parser, в конце обязательно /API
APARSER_API_URL=http://127.0.0.1:9091/API

# Пароль интерфейса A-Parser — он же пароль API. Пусто, если пароль не задан
APARSER_API_PASSWORD=

# Папка, куда распакован A-Parser (нужна server.py для start, stop и log)
APARSER_HOME=C:\A-parser

# Имя проксичекера в A-Parser: status покажет, сколько в нём живых прокси.
# Пусто — только общее число
APARSER_PROXY_CHECKER=mix

# Имя пресетов капчи, которые вы создали у Util::AntiGate, Util::ReCaptcha2
# и Util::Turnstile (README, шаг 5)
APARSER_CAPTCHA_PRESET=capmonster

# Ключ CapMonster Cloud — скилл по нему только показывает баланс в status и в панели
CAPMONSTER_KEY=

# Необязательно: логин и пароль прокси — чтобы они не всплывали в логах,
# которые печатает скилл
APARSER_PROXY_LOGIN=
APARSER_PROXY_PASSWORD=

# Необязательно: OpenAI для команды ai --engine openai (platform.openai.com → API keys).
# Оплата — по тарифу OpenAI за токены
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5-mini

# Необязательно: свой ключ Google Cloud для проверки safe_google (Safe Browsing API).
# Без ключа проверка идёт через общий ключ A-Parser, у которого часто кончается квота (429).
# Как получить — README, «Ограничения и тонкости»
GOOGLE_SAFEBROWSING_KEY=

# Необязательно: доступы для заготовок (python run.py stub). Заполняйте только те,
# которые будете разбирать. Для соцсетей берите отдельные аккаунты — за парсинг банят
APARSER_INSTAGRAM_COOKIE=
APARSER_QUORA_COOKIE=
APARSER_PERPLEXITY_COOKIES=
APARSER_KIMI_TOKEN=
APARSER_KEYSSO_USERLOGIN=
APARSER_GOOGLE_ADS_EMAIL=
APARSER_GOOGLE_ADS_PASSWORD=
APARSER_GOOGLE_ADS_COOKIES=
APARSER_SECURITYTRAILS_LOGIN=
APARSER_SECURITYTRAILS_PASSWORD=
